# LLM Configuration
# Choose one provider: openai, anthropic, or deepseek (compatible with openai format)
LLM_PROVIDER=openai

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
MODELSCOPE_API_KEY=sk-...

# Model Names
# OpenAI: gpt-4o, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20240620
# DeepSeek: deepseek-chat
# ModelScope: qwen-max, qwen-turbo
LLM_MODEL_NAME=gpt-4o

# ModelScope Base URL (Optional)
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# Optional: LangSmith Tracing (for debugging Agent flow)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2-...
