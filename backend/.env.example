# Runtime
APP_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_ISSUE_LIMIT=10
MAX_REQUEST_BYTES=65536
MAX_CONTEXT_CHARS=24000
METRICS_TOKEN=replace-with-at-least-32-random-characters
APP_VERSION=dev
LOG_LEVEL=INFO
SESSION_BUDGET_USD=0.50
MODEL_INPUT_COST_PER_1M_TOKENS=2.50
MODEL_OUTPUT_COST_PER_1M_TOKENS=10.00

# Single-machine model administrator
# Generate independent production secrets; never commit real values.
# Leave both values unset to create the sole administrator on the first visit to /admin.
# Alternatively set both values together to pre-seed an administrator during deployment.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_LIMIT=5
ADMIN_LOGIN_WINDOW_SECONDS=300
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
MODEL_CONFIG_DB_PATH=data/model-config.db
# Development-only opt-in for a local OpenAI-compatible test server.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# LLM Configuration
# Choose one provider: openai, anthropic, or deepseek (compatible with openai format)
LLM_PROVIDER=openai

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
MODELSCOPE_API_KEY=sk-...

# Model Names
# OpenAI: gpt-4o, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20240620
# DeepSeek: deepseek-chat
# ModelScope: qwen-max, qwen-turbo
LLM_MODEL_NAME=gpt-4o

# ModelScope Base URL (Optional)
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# Optional: enable only in an approved non-production debugging environment.
# Prompt/story payloads may be transmitted to the tracing provider.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2-...
