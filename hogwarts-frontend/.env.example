# Local development defaults to http://localhost:3000 when this variable is absent.
# Production deployments must set an explicit HTTPS API origin.
VITE_API_BASE_URL=http://localhost:3000

# Public production deployments must replace these values with reviewed information.
VITE_OPERATOR_NAME=Public MVP operator name
VITE_PRIVACY_CONTACT=https://example.com/privacy-contact
VITE_MODEL_DATA_DESTINATIONS=Configured model provider and processing region
